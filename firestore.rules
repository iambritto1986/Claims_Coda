rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) && 
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId && 
        incoming().diff(existing()).affectedKeys().hasOnly(['consentVersion']) &&
        (!('consentVersion' in incoming()) || (incoming().consentVersion is string && incoming().consentVersion.size() <= 64));
    }

    function isValidCase(data) {
      return data.keys().hasAll(['id', 'ownerId', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid &&
             data.status is string && data.status in ['draft', 'active', 'appealing', 'resolved', 'archived'];
    }

    match /cases/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(caseId) && 
                    isValidCase(incoming()) && 
                    incoming().createdAt == request.time && 
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(caseId) && existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    isValidCase(incoming());
      allow delete: if isSignedIn() && isValidId(caseId) && existing().ownerId == request.auth.uid;
      
      function isValidDocument(data) {
        return data.keys().hasAll(['id', 'caseId', 'type', 'createdAt']) &&
               data.id is string && data.id.size() <= 128 &&
               data.caseId is string && data.caseId == caseId &&
               data.type is string && data.type in ['denial', 'eob', 'medical_record', 'other'];
      }

      match /documents/{documentId} {
        allow get: if isSignedIn() && isValidId(caseId) && isValidId(documentId) && 
                   get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && isValidId(caseId) && 
                    get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(caseId) && isValidId(documentId) &&
                      get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid &&
                      isValidDocument(incoming()) && incoming().createdAt == request.time;
        allow delete: if isSignedIn() && isValidId(caseId) && isValidId(documentId) && 
                      get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
